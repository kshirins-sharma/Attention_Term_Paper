        <Param val="if key_resp.keys in (None, [], ''):&amp;#10;    fbText = 'Too slow! Please respond faster.'&amp;#10;    fbColor = 'black'&amp;#10;elif key_resp.corr:&amp;#10;    fbText = 'Correct!'&amp;#10;    fbColor = 'darkgreen'&amp;#10;else:&amp;#10;    fbText = 'Incorrect'&amp;#10;    fbColor = 'darkred'&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
