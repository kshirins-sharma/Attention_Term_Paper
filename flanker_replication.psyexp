        <Param val="mainText = (&quot;Practice is over.\n\n&quot;&amp;#10;    &quot;The main experiment will now begin. You will NOT receive feedback any more.\n\n&quot;&amp;#10;    &quot;Remember: respond only to the MIDDLE letter.\n&quot;&amp;#10;    + leftLetters + &quot;  -&gt;  Z        &quot; + rightLetters + &quot;  -&gt;  M\n\n&quot;&amp;#10;    &quot;There will be 4 blocks with short breaks in between.\n\n&quot;&amp;#10;    &quot;Press SPACE to start.&quot;)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
